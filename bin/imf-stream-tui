#!/usr/bin/env python3
"""
bin/imf-stream-tui
Terminal User Interface (TUI) for browsing the 113 consolidated Development Streams.
Uses curses for smooth, interactive navigation, phase filtering, and treatise preview.
"""

import curses
import json
import os
import sys

def load_streams():
    index_path = "dist/stream_search_index.json"
    if not os.path.exists(index_path):
        return []
    with open(index_path, "r", encoding="utf-8") as f:
        data = json.load(f)
    return data.get("streams", [])

def tui_main(stdscr):
    curses.curs_set(0)
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(2, curses.COLOR_GREEN, curses.COLOR_BLACK)
    curses.init_pair(3, curses.COLOR_YELLOW, curses.COLOR_BLACK)

    streams = load_streams()
    if not streams:
        stdscr.addstr(0, 0, "No streams found. Press any key to exit.")
        stdscr.getch()
        return

    current_idx = 0
    top_idx = 0

    while True:
        stdscr.clear()
        max_y, max_x = stdscr.getmaxyx()

        # Header
        header = "=== IMF MASTER DEVELOPMENT STREAMS EXPLORER (113 TREATISES / 447,277 WORDS) ==="
        stdscr.addstr(0, 2, header[:max_x-3], curses.A_BOLD | curses.color_pair(2))
        stdscr.addstr(1, 2, "Use UP/DOWN to navigate, ENTER to view preview, 'q' to quit", curses.color_pair(3))
        stdscr.addstr(2, 0, "-" * max_x)

        list_height = max_y - 5
        visible_streams = streams[top_idx:top_idx + list_height]

        for i, s in enumerate(visible_streams):
            actual_idx = top_idx + i
            title_text = f"[{s.get('phase', '')[:12]}] {s.get('title', '')} ({s.get('word_count', 0):,}w)"
            line_str = title_text[:max_x-4]

            if actual_idx == current_idx:
                stdscr.attron(curses.color_pair(1))
                stdscr.addstr(3 + i, 2, line_str.ljust(max_x - 4))
                stdscr.attroff(curses.color_pair(1))
            else:
                stdscr.addstr(3 + i, 2, line_str)

        stdscr.addstr(max_y - 1, 2, f"Stream {current_idx + 1} of {len(streams)}", curses.A_DIM)
        stdscr.refresh()

        key = stdscr.getch()
        if key == ord('q'):
            break
        elif key == curses.KEY_UP:
            if current_idx > 0:
                current_idx -= 1
                if current_idx < top_idx:
                    top_idx = current_idx
        elif key == curses.KEY_DOWN:
            if current_idx < len(streams) - 1:
                current_idx += 1
                if current_idx >= top_idx + list_height:
                    top_idx += 1
        elif key in [curses.KEY_ENTER, 10, 13]:
            # Preview modal
            selected = streams[current_idx]
            stdscr.clear()
            stdscr.addstr(1, 2, f"Treatise: {selected.get('title')}", curses.A_BOLD)
            stdscr.addstr(2, 2, f"Path: {selected.get('path')}", curses.color_pair(2))
            stdscr.addstr(3, 2, f"Words: {selected.get('word_count'):,} | Formulas: {selected.get('math_formula_count')}", curses.color_pair(3))
            stdscr.addstr(4, 2, "Sections:", curses.A_UNDERLINE)
            for h_i, h in enumerate(selected.get("headings", [])[:10]):
                if 5 + h_i < max_y - 3:
                    stdscr.addstr(5 + h_i, 4, f"- {h}")
            stdscr.addstr(max_y - 2, 2, "Press any key to return to stream list...", curses.A_STANDOUT)
            stdscr.getch()

if __name__ == '__main__':
    curses.wrapper(tui_main)
