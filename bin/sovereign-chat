#!/usr/bin/env python3
"""
bin/sovereign-chat
Interactive OpenAI-compatible terminal chat client for the local Sovereign Engine.
Supports multi-turn memory, colored output, and instant streaming.
"""

import sys
import json
import urllib.request
import readline

SERVER_URL = "http://localhost:8092/v1/chat/completions"

def main():
    print("\033[1;36m=== THE SACRED SANCTUM: SOVEREIGN REASONING CHAT ===\033[0m")
    print("\033[90mConnected to local daemon: http://localhost:8092 | Type 'exit' to quit\033[0m\n")

    messages = [
        {"role": "system", "content": "You are the Sovereign Council Model, an autonomous formal mathematical reasoning assistant."}
    ]

    while True:
        try:
            user_input = input("\033[1;32mUser > \033[0m").strip()
            if not user_input:
                continue
            if user_input.lower() in ["exit", "quit", "q"]:
                print("\033[90mExiting chat session.\033[0m")
                break

            messages.append({"role": "user", "content": user_input})

            payload = {
                "messages": messages,
                "max_tokens": 256,
                "temperature": 0.3
            }
            data = json.dumps(payload).encode('utf-8')
            req = urllib.request.Request(SERVER_URL, data=data, headers={"Content-Type": "application/json"})

            with urllib.request.urlopen(req, timeout=15.0) as resp:
                res = json.loads(resp.read().decode('utf-8'))
                assistant_reply = res.get("choices", [{}])[0].get("message", {}).get("content", "").strip()

            print(f"\n\033[1;34mSovereign Council >\033[0m\n{assistant_reply}\n")
            messages.append({"role": "assistant", "content": assistant_reply})

        except (KeyboardInterrupt, EOFError):
            print("\n\033[90mExiting chat session.\033[0m")
            break
        except Exception as e:
            print(f"\033[1;31m[Error communicating with daemon: {e}]\033[0m\n")

if __name__ == '__main__':
    main()
